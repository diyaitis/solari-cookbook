# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: POST a JSON payload here on every price drop / stock change.
# Works as-is with Discord and Slack incoming webhooks.
WEBHOOK_URL=

# Optional: path to the watchlist file. Defaults to ./watchlist.json
WATCHLIST_PATH=./watchlist.json
